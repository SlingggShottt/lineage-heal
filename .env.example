# .env.example
# Template for local configuration. Copy to .env and fill in real values; .env is
# gitignored and must never be committed or pasted into chat. In CI the same
# names are supplied as GitHub Actions secrets (docs/techstack.md, "Accounts and credentials").

# --- Logging (optional) ------------------------------------------------------
# LOG_LEVEL: DEBUG, INFO, WARNING or ERROR. LOG_FORMAT: "console" or "json".
LOG_LEVEL=INFO
LOG_FORMAT=console

# --- Source downloads ----------------------------------------------------------
# Minimum seconds between requests to a source site. Be polite; raise it if blocked.
INGEST_MIN_INTERVAL_SECONDS=3

# --- Raw zone ------------------------------------------------------------------
# "local" writes raw files under RAW_ZONE_DIR (safe default for development and tests).
# "r2" writes to the Cloudflare R2 bucket below and needs all four R2_ values.
# dbt reads the same RAW_ZONE_DIR for the dev, ci and bench targets.
RAW_ZONE_BACKEND=local
RAW_ZONE_DIR=.data/raw

# --- Warehouse (read by the Investigator's data tools) --------------------------
# The DuckDB file the agents inspect, opened read-only. dbt's dev target writes the same file
# when DBT_DATA_DIR is unset.
WAREHOUSE_PATH=.data/dev.duckdb

# --- Cloudflare R2: raw file storage (used when RAW_ZONE_BACKEND=r2) ---------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- dbt (optional) ------------------------------------------------------------
# Folder for the dev and bench DuckDB files. The default (.data, relative to where dbt runs)
# is right for the command line; Dagster sets an absolute path itself, so you rarely set this.
# DBT_DATA_DIR=.data

# --- Dagster (optional) ----------------------------------------------------------
# Where the Dagster instance keeps its settings and run history. `make dagster` sets this to
# dagster_home/ for you; set it yourself only to run `dagster` commands by hand.
# DAGSTER_HOME=

# --- MotherDuck: shared warehouse (needed from Week 3) -----------------------
MOTHERDUCK_TOKEN=

# --- Application database: Postgres (needed from LH-014) ---------------------
# With the local stack (`make up`), use:
#   postgresql+psycopg://lineageheal:lineageheal@localhost:5433/lineageheal
# Port 5433 avoids a clash with a Postgres already running on 5432. A hosted database
# such as Neon takes its own URL here.
DATABASE_URL=
# Used by docker-compose.yml only. Defaults are fine for a laptop.
POSTGRES_PASSWORD=lineageheal
POSTGRES_PORT=5433

# --- LLM providers (needed from Week 4) --------------------------------------
GEMINI_API_KEY=
GROQ_API_KEY=
# Model IDs and the client-side request rate per provider. The defaults follow
# docs/techstack.md; the IDs are confirmed against the providers by the smoke test in LH-093.
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_LIGHT_MODEL=gemini-3.1-flash-lite
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_REQUESTS_PER_MINUTE=10
# GROQ_REQUESTS_PER_MINUTE=20

# --- Knowledge index (LH-047) ------------------------------------------------
# Local embedding model, run through fastembed. Vectors are stored per model, so changing it
# re-embeds everything on the next `lineageheal index`. It must produce 384-dimension vectors.
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Where the model is downloaded (about 130 MB, once).
# EMBEDDING_CACHE_DIR=.data/models

# --- LangSmith: agent tracing (needed from Week 4) ---------------------------
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=lineageheal

# --- GitHub App: bot identity and dashboard sign-in (needed from Week 5) -----
GITHUB_APP_ID=
# The App's private key (.pem) on one line, with \n for each newline. A secret: never commit it.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=
# The repository the bot opens pull requests in, as owner/name, and the branch they target.
GITHUB_REPOSITORY=
GITHUB_BASE_BRANCH=main
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
SESSION_SECRET=
# Comma-separated GitHub logins allowed to approve or reject fixes.
APPROVER_GITHUB_LOGINS=

# --- HTTP API (`make api`) --------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
# Comma-separated origins allowed to call the API from a browser: the dashboard's own origin.
API_CORS_ORIGINS=http://localhost:5173

# --- Investigator budget (FR-INV-05) --------------------------------------------
# One investigation stops at whichever limit it reaches first, and an incident that runs out is
# reported with what was found so far. The call limit includes the final answer.
INVESTIGATOR_MAX_LLM_CALLS=12
INVESTIGATOR_MAX_SECONDS=120
# The search ends early once the leading cause is this certain and has two supporting findings.
INVESTIGATOR_CONFIDENCE_THRESHOLD=0.8

# --- Fixer limits (FR-FIX-01) -----------------------------------------------------
# A patch larger than this is rejected before it is tested, so every fix stays reviewable. The
# call limit is the first answer plus corrections for an answer the checks refused.
FIXER_MAX_LLM_CALLS=2
FIXER_MAX_FILES=4
FIXER_MAX_CHANGED_LINES=120
# Sandbox attempts per incident (FR-FIX-03), and the longest one dbt build may run.
FIXER_MAX_ATTEMPTS=2
SANDBOX_TIMEOUT_SECONDS=600
