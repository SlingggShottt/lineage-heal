# .env.example
# Template for local configuration. Copy to .env and fill in real values; .env is
# gitignored and must never be committed or pasted into chat. In CI the same
# names are supplied as GitHub Actions secrets (docs/techstack.md, "Accounts and credentials").

# --- Logging (optional) ------------------------------------------------------
# LOG_LEVEL: DEBUG, INFO, WARNING or ERROR. LOG_FORMAT: "console" or "json".
LOG_LEVEL=INFO
LOG_FORMAT=console

# --- Source downloads ----------------------------------------------------------
# Minimum seconds between requests to a source site. Be polite; raise it if blocked.
INGEST_MIN_INTERVAL_SECONDS=3

# --- Raw zone ------------------------------------------------------------------
# "local" writes raw files under RAW_ZONE_DIR (safe default for development and tests).
# "r2" writes to the Cloudflare R2 bucket below and needs all four R2_ values.
# dbt reads the same RAW_ZONE_DIR for the dev, ci and bench targets.
RAW_ZONE_BACKEND=local
RAW_ZONE_DIR=.data/raw

# --- Cloudflare R2: raw file storage (used when RAW_ZONE_BACKEND=r2) ---------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- dbt (optional) ------------------------------------------------------------
# Folder for the dev and bench DuckDB files. The default (.data, relative to where dbt runs)
# is right for the command line; Dagster sets an absolute path itself, so you rarely set this.
# DBT_DATA_DIR=.data

# --- Dagster (optional) ----------------------------------------------------------
# Where the Dagster instance keeps its settings and run history. `make dagster` sets this to
# dagster_home/ for you; set it yourself only to run `dagster` commands by hand.
# DAGSTER_HOME=

# --- MotherDuck: shared warehouse (needed from Week 3) -----------------------
MOTHERDUCK_TOKEN=

# --- Application database: Postgres (needed from LH-014) ---------------------
# With the local stack (`make up`), use:
#   postgresql+psycopg://lineageheal:lineageheal@localhost:5433/lineageheal
# Port 5433 avoids a clash with a Postgres already running on 5432. A hosted database
# such as Neon takes its own URL here.
DATABASE_URL=
# Used by docker-compose.yml only. Defaults are fine for a laptop.
POSTGRES_PASSWORD=lineageheal
POSTGRES_PORT=5433

# --- LLM providers (needed from Week 4) --------------------------------------
GEMINI_API_KEY=
GROQ_API_KEY=

# --- LangSmith: agent tracing (needed from Week 4) ---------------------------
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=lineageheal

# --- GitHub App: bot identity and dashboard sign-in (needed from Week 5) -----
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
SESSION_SECRET=
# Comma-separated GitHub logins allowed to approve or reject fixes.
APPROVER_GITHUB_LOGINS=
