{
  "components": {
    "schemas": {
      "FieldError": {
        "description": "One rejected input: where it was, and why. The submitted value is deliberately absent.",
        "properties": {
          "field": {
            "title": "Field",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "field",
          "message"
        ],
        "title": "FieldError",
        "type": "object"
      },
      "Liveness": {
        "description": "The process is up.",
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version"
        ],
        "title": "Liveness",
        "type": "object"
      },
      "Me": {
        "description": "Who is asking. Anonymous visitors get `signed_in: false` and nothing else.",
        "properties": {
          "csrf_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Csrf Token"
          },
          "expires_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At"
          },
          "is_approver": {
            "default": false,
            "title": "Is Approver",
            "type": "boolean"
          },
          "login": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Login"
          },
          "signed_in": {
            "title": "Signed In",
            "type": "boolean"
          }
        },
        "required": [
          "signed_in"
        ],
        "title": "Me",
        "type": "object"
      },
      "Problem": {
        "description": "The body of every error response.",
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/FieldError"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Errors"
          },
          "instance": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Instance"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status"
        ],
        "title": "Problem",
        "type": "object"
      },
      "Readiness": {
        "description": "The process is up and its database is reachable and migrated.",
        "properties": {
          "head": {
            "title": "Head",
            "type": "string"
          },
          "revision": {
            "title": "Revision",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "revision",
          "head"
        ],
        "title": "Readiness",
        "type": "object"
      }
    }
  },
